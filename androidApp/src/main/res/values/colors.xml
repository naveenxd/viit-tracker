<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon tile: bright, non-white backdrop so the mark reads on
         both light and dark launchers. Splash keeps the app's dark surface. -->
    <color name="launcher_background">#FFE5F0FA</color>
    <color name="splash_bg">#FF0A0A0A</color>

    <!-- Widget colors — mirrors TrackerColors so the widget and app agree. -->
    <color name="surface_dark">#FF0A0A0A</color>
    <color name="surface_elevated">#FF171717</color>

    <color name="text_primary">#FFEDEDED</color>
    <color name="text_secondary">#FFB0B0B4</color>
    <color name="text_muted">#FF8A8A8F</color>
    <color name="text_subtle">#FF6B6B70</color>

    <color name="hairline_border">#FF2C2C30</color>
    <color name="hairline_border_light">#FF3A3A3F</color>

    <!-- Widget card edge — the in-app hairlines are invisible against a black
         card, so the widget gets a slightly brighter stroke of its own. -->
    <color name="widget_border">#FF42464F</color>

    <color name="safe_emerald">#FF22C55E</color>
    <color name="safe_emerald_subtle">#1522C55E</color>

    <color name="warning_amber">#FFF59E0B</color>
    <color name="warning_amber_subtle">#1FF59E0B</color>

    <color name="danger_rose">#FFEF4444</color>
    <color name="danger_rose_subtle">#15EF4444</color>

    <color name="primary_accent">#FFFFFFFF</color>
    <color name="primary_white">#FFFFFFFF</color>
</resources>
