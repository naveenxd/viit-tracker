<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:orientation="vertical"
    android:padding="12dp">
    
    <!-- Student Name -->
    <TextView
        android:id="@+id/widget_student_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STUDENT"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="8dp" />
    
    <!-- Attendance Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        
        <!-- Attendance Percentage -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/widget_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85.5%"
                android:textColor="@color/safe_emerald"
                android:textSize="22sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAFE"
                android:textColor="@color/safe_emerald"
                android:textSize="7sp"
                android:textStyle="bold"
                android:padding="1dp"
                android:background="@drawable/status_background_safe" />
        </LinearLayout>
        
        <!-- Skip Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            
            <TextView
                android:id="@+id/widget_skip_indicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:text="✓"
                android:textColor="@color/safe_emerald"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/today_status_background_safe" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKIP"
                android:textColor="@color/text_muted"
                android:textSize="7sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>
    
    <!-- Bottom Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <!-- Roll Number -->
        <TextView
            android:id="@+id/widget_roll_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Roll No"
            android:textColor="@color/text_muted"
            android:textSize="8sp"
            android:maxLines="1"
            android:ellipsize="end" />
            
        <!-- Today Status -->
        <TextView
            android:id="@+id/widget_today_status"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:text="✓"
            android:textColor="@color/safe_emerald"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/today_status_background_safe" />
    </LinearLayout>
    
</LinearLayout>