<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: rounded + slightly inset so the launcher's own corner rounding
     can't clip the border away. A shallow top-down gradient gives the black card
     a little depth without turning into a glow. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetTop="2dp"
    android:insetRight="2dp"
    android:insetBottom="2dp">

    <shape android:shape="rectangle">
        <gradient
            android:angle="270"
            android:endColor="#FF0A0A0B"
            android:startColor="#FF17181B" />
        <stroke
            android:width="1dp"
            android:color="@color/widget_border" />
        <corners android:radius="18dp" />
    </shape>

</inset>
