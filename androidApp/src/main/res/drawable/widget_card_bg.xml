<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: rounded + slightly inset so the launcher's own corner rounding
     can't clip the border away, with a hairline bright enough to actually read. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetTop="2dp"
    android:insetRight="2dp"
    android:insetBottom="2dp">

    <shape android:shape="rectangle">
        <solid android:color="@color/surface_dark" />
        <stroke
            android:width="1dp"
            android:color="@color/widget_border" />
        <corners android:radius="16dp" />
    </shape>

</inset>
