<?xml version="1.0" encoding="utf-8"?>
<!-- Compact tap target for the refresh action. The whole card is clickable, so
     this only has to read as an affordance, not carry the hit area on its own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <solid android:color="#14FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#24FFFFFF" />
    <corners android:radius="7dp" />

</shape>
